# face-id-verification environment variables
#
# Copy to `.env` and export, OR set these in your shell/IDE before running.
# The CLI reads them directly from the process environment (it does NOT load
# the .env file automatically), so export them, e.g. on Windows PowerShell:
#
#     $env:SEPOLIA_RPC_URL = "..."
#     $env:SEPOLIA_PRIVATE_KEY = "..."
#
# Never commit real values to source control.

# --- Blockchain (Sepolia) ---------------------------------------------------
# HTTPS RPC endpoint for the Sepolia testnet (e.g. from a node provider).
SEPOLIA_RPC_URL=

# Private key for a Sepolia test account that holds test ETH for gas.
# Use a SEPOLIA-ONLY test account; never use a mainnet key.
SEPOLIA_PRIVATE_KEY=

# Optional: VerificationRegistry address used by the Sepolia integration tests.
# Defaults to the pre-deployed instance documented in docs/setup/contract.md.
# Test-only; the application never reads this variable.
SEPOLIA_CONTRACT_ADDRESS=

# --- SerpApi Google Lens (reverse image search) ------------------------------
# Required for the Reverse Image Search stage. An API key from
# https://serpapi.com/manage-api-key. Without it the stage is reported BLOCKED.
SERPAPI_API_KEY=

# --- Google Cloud Vision (reverse image search, LEGACY/optional) -------------
# Optional: the default provider is SerpApi Google Lens (SERPAPI_API_KEY above).
# The legacy Google Cloud Vision Web Detection provider uses GOOGLE_APPLICATION_CREDENTIALS
# (or Application Default Credentials) and is not the default anymore. Keep this
# only if you intentionally run the legacy provider.
GOOGLE_APPLICATION_CREDENTIALS=
