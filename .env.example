# MukhdaX
SERPAPI_API_KEY=

# Must be an Ethereum Sepolia JSON-RPC endpoint (chain ID 11155111).
# A mainnet or other-network endpoint is rejected before any transaction is built.
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
SEPOLIA_CONTRACT_ADDRESS=0x76BfcB45C918C13fAAAf79D51f94fE5B29aFEB53

# Authorization credential required to spend the Sepolia key, ETH, and RPC quota through
# POST /api/verify. It is a separate credential from the blockchain secrets above, is
# sent as 'Authorization: Bearer <token>', and is never needed for local verification
# with enable_blockchain=false. It must NOT be embedded in the shipped frontend bundle.
MUKHDAX_WEB_WRITE_TOKEN=

# Comma-separated Host values the web service will answer to. Defaults to the loopback
# names and addresses; anything else (a reverse proxy, a LAN demo) must be listed here.
MUKHDAX_WEB_ALLOWED_HOSTS=

# Comma-separated browser origins allowed to reach a blockchain write, overriding the
# default loopback origins. Needed only when a trusted proxy serves the UI from another
# origin; leave empty for the default local deployment.
MUKHDAX_WEB_TRUSTED_ORIGINS=
