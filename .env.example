# MukhdaX
# Copy to .env and fill in what you need. The CLI (face-id-verification) and the web
# server (python -m face_id_verification.web) call load_local_config() at startup, which
# reads this file. Direct library use reads the process environment only. Variables
# already set in the environment are never overwritten, and a .env found in an unrelated
# directory is ignored. Never commit the real file - only this example.
SERPAPI_API_KEY=

# Must be an Ethereum Sepolia JSON-RPC endpoint (chain ID 11155111).
# A mainnet or other-network endpoint is rejected before any transaction is built.
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=

# Read by the TEST SUITE only, to point at its own deployment. The pipeline never reads
# it: there is no CONTRACT_ADDRESS variable, and the address is passed per run with
# --contract-address or in the web form.
SEPOLIA_CONTRACT_ADDRESS=0x76BfcB45C918C13fAAAf79D51f94fE5B29aFEB53

# Authorization credential required to spend the Sepolia key, ETH, and RPC quota through
# POST /api/verify. It is a separate credential from the blockchain secrets above, is
# sent as 'Authorization: Bearer <token>', and is never needed for local verification
# with enable_blockchain=false. It must NOT be embedded in the shipped frontend bundle.
# If it is unset, blockchain writes are refused outright; read-only runs still work.
MUKHDAX_WEB_WRITE_TOKEN=

# Where the web server listens. Keep the loopback default unless you are deliberately
# exposing it - this service has no user authentication, only the write token above.
# 0.0.0.0 would bind every interface, which is almost never what you want locally.
FACE_ID_WEB_HOST=127.0.0.1
FACE_ID_WEB_PORT=8000

# Comma-separated Host values the web service will answer to. Defaults to the loopback
# names and addresses; anything else (a reverse proxy, a LAN demo) must be listed here.
MUKHDAX_WEB_ALLOWED_HOSTS=

# Comma-separated browser origins allowed to reach a blockchain write, overriding the
# default loopback origins. Needed only when a trusted proxy serves the UI from another
# origin; leave empty for the default local deployment.
MUKHDAX_WEB_TRUSTED_ORIGINS=

# Bounded admission for POST /api/verify. Defaults to 10 requests per 60 seconds per
# client. The client is the transport peer address; X-Forwarded-For is believed only when
# the immediate peer is listed in MUKHDAX_WEB_TRUSTED_PROXY_HOSTS. The limiter is
# per-process and in-memory, so it is not a distributed limit.
MUKHDAX_WEB_RATE_LIMIT=
MUKHDAX_WEB_RATE_WINDOW_SECONDS=
MUKHDAX_WEB_TRUSTED_PROXY_HOSTS=

# Test-suite opt-ins. Nothing below is read by the pipeline itself.
#
# MUKHDAX_TEST_LIVE_WRITES=1
#   Required, on top of real Sepolia credentials, for the two tests that broadcast real
#   transactions and spend real testnet ETH. A populated .env alone is never enough.
#
# MUKHDAX_TEST_ALLOW_DOWNLOADS=1
#   Required for the face-analyzer integration fixtures, which download portraits from
#   randomuser.me. Without it those tests skip with an explicit reason.
#
# GOOGLE_APPLICATION_CREDENTIALS
#   Resolved by the Google SDK, not by MukhdaX. Only relevant to the optional, non-default
#   GoogleVisionSearcher provider (see docs/setup/gcp.md).
